# CortexOS repository ignore policy
# Keep this file intentionally explicit: source, docs, tests, lockfiles, and reviewed
# attribution remain trackable; machine-local state, secrets, caches, and generated
# output do not.

# ------------------------------------------------------------------------------
# Operating system noise
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# Editors and IDEs
# ------------------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
!.vscode/tasks.example.json
.history/
.project
.classpath
.settings/

# ------------------------------------------------------------------------------
# Secrets and machine-local configuration
# ------------------------------------------------------------------------------
# Never commit real environment files or local overrides.
.env
.env.*
!.env.example
!.env.*.example
*.local
*.local.*
!.local.example

# MCP client configs can contain credentials or machine-specific paths.
.mcp.json
!.mcp.json.example

# Private project-agent instructions and local OpenCode settings stay on the
# developer machine and are never published to the remote repository.
RULES.md
opencode.json

# Local application state and credentials.
.cortexos/
.cortexos-*/
.agency-os/
.local-state/
.local-secrets/
secrets/
credentials/
*.secret
*.secret.*
*.pem
*.key
*.key.pem
*.p12
*.pfx
*.jks
*.keystore

# Local databases and write-ahead logs. Test fixtures must use an explicit
# example/fixture extension or be force-added after review.
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# ------------------------------------------------------------------------------
# Go toolchain and generated binaries
# ------------------------------------------------------------------------------
# Keep go.mod, go.sum, go.work, and go.work.sum trackable.
*.exe
*.exe.manifest
*.dll
*.so
*.dylib
*.test
*.out
*.prof
coverage.out
coverage.html
coverprofile.out
bench.out

# Common local Go output/cache directories.
/bin/
/bin-debug/
/bin-release/
.gocache/
.gopath/

# ------------------------------------------------------------------------------
# Node, React, TypeScript, and frontend tooling
# ------------------------------------------------------------------------------
node_modules/
.pnpm-store/
.npm/
.yarn/
!.yarn/patches/
!.yarn/plugins/
!.yarn/releases/
!.yarn/sdks/
!.yarn/versions/
.yarnrc.local
.pnp.*

# Build and test output. Lockfiles are deliberately not ignored.
web/node_modules/
web/dist/
web/build/
web/.vite/
web/.cache/
web/coverage/
web/.nyc_output/
web/wailsjs/
web/package.json.md5
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
frontend/.cache/
frontend/coverage/
frontend/.nyc_output/
*.tsbuildinfo

# ------------------------------------------------------------------------------
# Wails and CortexOS build output
# ------------------------------------------------------------------------------
# Keep source assets under build/assets trackable. Ignore only generated output.
build/bin/
build/installer/
build/*.exe
build/*.msi
build/*.msix
build/*.appimage
build/*.dmg
build/*.deb
build/*.rpm
build/*.zip
build/*.tar.gz
wails-build/

# ------------------------------------------------------------------------------
# Harvest workspace
# ------------------------------------------------------------------------------
# Raw third-party clones are reproducible source material and must not be pushed.
# Review extracted material for license/attribution before deliberately tracking it.
_harvest/raw/
_harvest/**/.git/
_harvest/**/.gitignore

# Keep the review note visible, but ignore unreviewed extracted third-party code,
# prompts, and binary assets by default. Reviewed material should be moved into a
# documented, first-party location or explicitly force-added after license review.
_harvest/extracted/*
!_harvest/extracted/ATTRIBUTION-REVIEW.md
!_harvest/extracted/**/
!_harvest/extracted/**/.gitkeep
!_harvest/harvest-manifest.json

# ------------------------------------------------------------------------------
# Logs, temporary files, and local exports
# ------------------------------------------------------------------------------
*.log
logs/
log/
tmp/
temp/
.tmp/
.cache/
.cache-*/
*.tmp
*.temp
*.swp
*.swo
*.pid
*.pid.lock
*.bak
*.orig
*.rej

# Local reports and exports generated by tools.
reports/
artifacts/
exports/

# ------------------------------------------------------------------------------
# Infrastructure and tool-local state
# ------------------------------------------------------------------------------
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl
.serverless/
.aws-sam/

# ------------------------------------------------------------------------------
# Explicitly keep important project files trackable
# ------------------------------------------------------------------------------
!.gitignore
!docs/
!discuss/
!scripts/
!test/
!web/
!internal/
!cmd/
!configs/
!configs/*.example.*
!_harvest/
!_harvest/extracted/
!_harvest/extracted/ATTRIBUTION-REVIEW.md
!_harvest/harvest-manifest.json
